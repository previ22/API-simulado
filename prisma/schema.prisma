generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}
 
datasource db {
  provider = "sqlite"
}
 
model Palestrante {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  eventos   Eventos[]
}
 
model Eventos {
  id          Int          @id @default(autoincrement())
  name        String
  local       String
  descricao   String
  palestrante Palestrante? @relation(fields: [palestranteId], references: [id])
  palestranteId Int?
}









